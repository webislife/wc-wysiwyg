{
  "name": "wc-wysiwyg-editor",
  "version": "1.0.6",
  "description": "WYSIWYG HTML5 editor written in TypeScript as a dependency-free web component, works with all JS frameworks and browsers",
  "type": "module",
  "main": "./dist/wc-wysiwyg.umd.cjs",
  "module": "./dist/wc-wysiwyg.es.js",
  "types": "./dist/wc-wysiwyg.d.ts",
  "exports": {
    ".": {
      "types": "./dist/wc-wysiwyg.d.ts",
      "import": "./dist/wc-wysiwyg.es.js",
      "require": "./dist/wc-wysiwyg.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webislife/wc-wysiwyg.git"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "html5 editor",
    "wysiwyg",
    "html5",
    "typescript"
  ],
  "author": "srokoff",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webislife/wc-wysiwyg/issues"
  },
  "homepage": "https://github.com/webislife/wc-wysiwyg#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sass": "^1.62.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
